<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroLauncher.ViewModels"
             xmlns:settingsPageViews="clr-namespace:AstroLauncher.Views.SettingsPageViews"
             xmlns:settingsPageViewModels="clr-namespace:AstroLauncher.ViewModels.SettingsPageViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="AstroLauncher.Views.SettingsView"
             x:CompileBindings="True"
             
             xmlns:conv="using:AstroLauncher.Utils">
    
    <Border>
        <Grid Margin="15" RowDefinitions="Auto,Auto,*">
           <TextBlock Grid.Row="0" Text="Settings" Classes="Header"/>
           <TextBlock Grid.Row="1"  Text="Customize your launcher experience" Classes="Description"/>
           
           <Grid Grid.Row="2"  ColumnDefinitions="210, *" Margin="0,15,0,0">
               <!-- SETTINGS TAB -->
               <ListBox ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        Classes="BaseListBox">
                       
                   <ListBox.ItemTemplate>
                       <DataTemplate x:DataType="vm:ViewModelBase">
                           <StackPanel Orientation="Horizontal" Spacing="12">
                               <Path Data="{Binding IconData}"
                                     Width="18" Height="18"
                                     Stretch="Uniform"
                                     Stroke="White"
                                     StrokeThickness="2"
                                     StrokeLineCap="Round"
                                     StrokeJoin="Round"/>
                               <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                           </StackPanel>
                       </DataTemplate>
                   </ListBox.ItemTemplate>
               </ListBox>
               
               <!-- SETTINGS MAIN AREA -->
               <Border Grid.Column="1">
                   <ContentControl Content="{Binding SelectedCategory}">
                       <ContentControl.DataTemplates>
                           <!-- General -->
                           <DataTemplate DataType="{x:Type settingsPageViewModels:GeneralViewModel}">
                               <settingsPageViews:GeneralView/>
                           </DataTemplate>
                           
                           <!-- Privacy & Security -->
                           <DataTemplate DataType="{x:Type settingsPageViewModels:PrivacyAndSecurityViewModel}">
                               <settingsPageViews:PrivacyAndSecurityView/>
                           </DataTemplate>
                                                        
                           <!-- Launcher -->
                           <DataTemplate DataType="{x:Type settingsPageViewModels:LauncherViewModel}">
                               <settingsPageViews:LauncherView/>
                           </DataTemplate>
                           
                           <!-- About -->
                           <DataTemplate DataType="{x:Type settingsPageViewModels:AboutViewModel}">
                               <settingsPageViews:AboutView/>
                           </DataTemplate>
                       </ContentControl.DataTemplates>
                   </ContentControl>
               </Border>
           </Grid>
       </Grid>
   </Border>
</UserControl>