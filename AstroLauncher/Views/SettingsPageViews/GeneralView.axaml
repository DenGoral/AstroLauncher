<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroLauncher.ViewModels"
             xmlns:viewModels="clr-namespace:AstroLauncher.ViewModels.SettingsPageViewModels"
             xmlns:controls="clr-namespace:AstroLauncher.Controls"
             x:DataType="viewModels:GeneralViewModel"
             x:CompileBindings="True"
             x:Class="AstroLauncher.Views.SettingsPageViews.GeneralView">
    
    <StackPanel Margin="20" Spacing="15">
        <!-- GENERAL -->
        <TextBlock Text="General" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
        <Border Classes="InnerSurface">
            <StackPanel Spacing="2">
                <!-- START ON STARTUP -->
                <controls:SettingItem Header="Start on system startup" 
                                      Description="Launch Astro Launcher when your computer starts"
                                      IconData="{StaticResource PowerIcon}">
                    <controls:SettingItem.ActionContent>
                        <ToggleSwitch Classes="SettingsToggle"/>
                    </controls:SettingItem.ActionContent>
                </controls:SettingItem>
                
                <Border Classes="Divider" />

                <!-- MINIMIZE TO TRAY -->
                <controls:SettingItem Header="Minimize to system tray" 
                                      Description="Close button will minimize the launcher to tray"
                                      IconData="{StaticResource SquareIcon}">
                    <controls:SettingItem.ActionContent>
                        <ToggleSwitch Classes="SettingsToggle"/>
                    </controls:SettingItem.ActionContent>
                </controls:SettingItem>
                
                <Border Classes="Divider" />

                <!-- LANGUAGE -->
                <controls:SettingItem Header="Language" 
                                      Description="Choose your preferred language"
                                      IconData="{StaticResource LangIcon}">
                    <controls:SettingItem.ActionContent>
                        <ComboBox Width="120" ItemsSource="{Binding Languages}" SelectedItem="{Binding ChosenLanguage}"/>
                    </controls:SettingItem.ActionContent>
                </controls:SettingItem>
            </StackPanel>
        </Border>
        
        <Border Classes="Divider" Height="3" Margin="15,0"/>
        
        <!-- PERFORMANCE -->
        <TextBlock Text="Performance" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
        <Border Classes="InnerSurface">
            <StackPanel Spacing="2">
                <!-- MAX DOWNLOADS -->
                <controls:SettingItem Header="Maximum concurrent downloads"
                                      Description="Number of files to download at the same time">
                    <controls:SettingItem.ActionContent>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Width="200"
                                    Minimum="1" Maximum="8"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding MaxDownloads}"/>
                            <TextBlock Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding MaxDownloads}"/>
                        </StackPanel>
                    </controls:SettingItem.ActionContent>
                </controls:SettingItem>
                
                <!-- THROTTLE DOWNLOAD-->
                <controls:SettingItem Header="Throttle downloads"
                                      Description="Limit download speed to prevent network congestion">
                    <controls:SettingItem.ActionContent>
                        <ToggleSwitch Classes="SettingsToggle"/>
                    </controls:SettingItem.ActionContent>
                </controls:SettingItem>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>