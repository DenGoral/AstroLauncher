<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AstroLauncher.ViewModels"
             xmlns:viewModels="clr-namespace:AstroLauncher.ViewModels.SettingsPageViewModels"
             xmlns:controls="clr-namespace:AstroLauncher.Controls"
             x:DataType="viewModels:GeneralViewModel"
             x:CompileBindings="True"
             x:Class="AstroLauncher.Views.SettingsPageViews.GeneralView">
    
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        
        <StackPanel Margin="20" Spacing="15">
            <!-- GENERAL -->
            <TextBlock Text="General" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <Border Classes="InnerSurface">
                <StackPanel Spacing="2">
                    <!-- START ON STARTUP -->
                    <controls:SettingItem Header="Start on system startup" 
                                          Description="Launch Astro Launcher when your computer starts"
                                          IconData="{StaticResource PowerIcon}">
                        <controls:SettingItem.ActionContent>
                            <ToggleSwitch Classes="SettingsToggle"/>
                        </controls:SettingItem.ActionContent>
                    </controls:SettingItem>
                    
                    <Border Classes="Divider" />

                    <!-- MINIMIZE TO TRAY -->
                    <controls:SettingItem Header="Minimize to system tray" 
                                          Description="Close button will minimize the launcher to tray"
                                          IconData="{StaticResource SquareIcon}">
                        <controls:SettingItem.ActionContent>
                            <ToggleSwitch Classes="SettingsToggle"/>
                        </controls:SettingItem.ActionContent>
                    </controls:SettingItem>
                    
                    <Border Classes="Divider" />

                    <!-- LANGUAGE -->
                    <controls:SettingItem Header="Language" 
                                          Description="Choose your preferred language"
                                          IconData="{StaticResource LangIcon}">
                        <controls:SettingItem.ActionContent>
                            <ComboBox Width="120" ItemsSource="{Binding Languages}" SelectedItem="{Binding ChosenLanguage}"/>
                        </controls:SettingItem.ActionContent>
                    </controls:SettingItem>
                </StackPanel>
            </Border>
            
            <Border Classes="Divider" Height="3" Margin="15,0"/>
            
            <!-- PERFORMANCE -->
            <TextBlock Text="Performance" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <Border Classes="InnerSurface">
                <StackPanel Spacing="2">
                    <!-- MAX DOWNLOADS -->
                    <controls:SettingItem Header="Maximum concurrent downloads"
                                          Description="Number of files to download at the same time">
                        <controls:SettingItem.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Slider Width="200"
                                        Minimum="1" Maximum="8"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding MaxDownloads}"
                                        Classes="SettingsSlider"/>
                                <TextBlock Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding MaxDownloads}"/>
                            </StackPanel>
                        </controls:SettingItem.ActionContent>
                    </controls:SettingItem>
                    
                    <Border Classes="Divider" />
                    
                    <!-- THROTTLE DOWNLOAD-->
                    <controls:SettingItem Header="Throttle downloads"
                                          Description="Limit download speed to prevent network congestion">
                        <controls:SettingItem.ActionContent>
                            <ToggleSwitch Classes="SettingsToggle"/>
                        </controls:SettingItem.ActionContent>
                    </controls:SettingItem>
                </StackPanel>
            </Border>
            
            <Border Classes="Divider" Height="3" Margin="15,0"/>
            
            <!-- APPEARANCE -->
            <TextBlock Text="Appearance" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <Border Classes="InnerSurface">
                <StackPanel Spacing="2">
                    <!-- THEME -->
                    <controls:SettingItem Header="Theme" 
                                          Description="Change theme of the launcher to your preference.">
                        <controls:SettingItem.ActionContent>
                            <ComboBox SelectedIndex="0" Width="180" 
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"/>
                        </controls:SettingItem.ActionContent>
                    </controls:SettingItem>
                    
                    <Border Classes="Divider"/>
                    
                    <!-- ACCENT COLOR -->
                    <controls:SettingItem Header="Accent Color"
                                          Description="Change launchers accent color.">
                        <controls:SettingItem.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Purple-->
                                <RadioButton Classes="AccentSwatch" GroupName="Accent" Background="#8C66FF"
                                             IsChecked="True"
                                             Command="{Binding SetAccentCommand}" CommandParameter="#8C66FF"/>
                                
                                <!-- Blue-->
                                <RadioButton Classes="AccentSwatch" GroupName="Accent" Background="#3B82F6"
                                             Command="{Binding SetAccentCommand}" CommandParameter="#3B82F6"/>
                                
                                <!-- Light green-->
                                <RadioButton Classes="AccentSwatch" GroupName="Accent" Background="#68C258"
                                             Command="{Binding SetAccentCommand}" CommandParameter="#68C258"/>
                                
                                <!-- Pink-->
                                <RadioButton Classes="AccentSwatch" GroupName="Accent" Background="#CF458F"
                                             Command="{Binding SetAccentCommand}" CommandParameter="#CF458F"/>
                                
                                <!-- Orange-->
                                <RadioButton Classes="AccentSwatch" GroupName="Accent" Background="#DFB045"
                                             Command="{Binding SetAccentCommand}" CommandParameter="#DFB045"/>
                                <!-- more swatches later -->
                            </StackPanel>
                        </controls:SettingItem.ActionContent>
                    </controls:SettingItem>
                </StackPanel>
            </Border>    
        </StackPanel>
    </ScrollViewer>
</UserControl>