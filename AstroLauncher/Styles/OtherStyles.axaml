<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style Selector="ComboBox.DefaultComboBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="MaxDropDownHeight" Value="200"/>
    </Style>
    
    <Style Selector="ComboBox /template/ Path#DropDownGlyph">
        <Setter Property="Fill" Value="Red" />
    </Style>
    
    <Style Selector="Border.InnerSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceCard}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    
    <Style Selector="Border.Divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="Background" Value="#1E2030"/>
    </Style>
    
    <Style Selector="ToggleSwitch.SettingsToggle Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
    </Style>
    
    <Style Selector="ToggleSwitch.SettingsToggle:pointerover:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
    </Style>
    
    <Style Selector="ToggleSwitch.SettingsToggle:pressed:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
    </Style>
    
    <Style Selector="Slider.SettingsSlider">
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>

        <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        </Style>

        <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>

            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        
        <Style Selector="^ /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        </Style>
    </Style>
    
    <Style Selector="Path.BaseIcon">
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <Style Selector="RadioButton.AccentSwatch">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Ring"
                            CornerRadius="14"
                            BorderThickness="2"
                            BorderBrush="{TemplateBinding Background}"
                            Opacity="0">
                        
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    
                    <Border Margin="4"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="RadioButton.AccentSwatch:checked /template/ Border#Ring">
        <Setter Property="Opacity" Value="1"/>
    </Style>
</Styles>