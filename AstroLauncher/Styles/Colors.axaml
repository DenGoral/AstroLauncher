<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="AccentColor">#8C66FF</SolidColorBrush>
    
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SurfaceMain">#0A0E14</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceCard">#252733</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceSecondary">#0D111D</SolidColorBrush>
            <SolidColorBrush x:Key="TextPrimary">White</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondary">LightSlateGray</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SurfaceMain">#EDF1F7</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceCard">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceSecondary">#E2E7F0</SolidColorBrush>
            <SolidColorBrush x:Key="TextPrimary">#0A0E14</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondary">#5C6B7F</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>