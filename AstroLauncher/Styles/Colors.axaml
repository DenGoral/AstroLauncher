<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="AccentColor">#8C66FF</SolidColorBrush>
    
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SurfaceMain">#0A0E14</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceCard">#252733</SolidColorBrush>
            <SolidColorBrush x:Key="TextPrimary">White</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondary">LightSlateGray</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceSecondary">#0D111D</SolidColorBrush>
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SurfaceMain">#F3F5F9</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceCard">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceSecondary">#E9ECF3</SolidColorBrush>
            <SolidColorBrush x:Key="TextPrimary">#111827</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondary">#64748B</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>